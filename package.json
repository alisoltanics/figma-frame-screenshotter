{
  "name": "figma-frame-screenshotter",
  "version": "1.2.0",
  "private": true,
  "description": "Capture Figma frames as PNG files",
  "author": "Figma Frame Screenshotter",
  "desktopName": "figma-frame-screenshotter.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "cli": "electron cli.js",
    "install:desktop": "bash install.sh",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0"
  }
}
